
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "types": [
      "node",
      "@playwright/test"
    ],

    "noEmit": true
  },

  "include": [
    "tests/**/*.ts",
    "pages/**/*.ts",
    "fixture/**/*.ts",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report",
    "allure-results",
    "allure-report"
  ]
}
